        <mxCell id="server" value="WEARO SERVER / API&#xa;&#xa;• Validate input&#xa;• Auth / access control&#xa;• Chuẩn hóa request&#xa;• Không expose API secret" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="390" y="180" width="280" height="150" as="geometry"/></mxCell>
