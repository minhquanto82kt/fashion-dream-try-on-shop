        <mxCell id="note" value="FLOW: Upload/Input → Server → AI Provider → Result → Storage → UI&#xa;&#xa;Database là source of truth cho metadata; AI secret không đi qua client.&#xa;Error/timeout phải trả về trạng thái rõ ràng để UI hiển thị retry." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontSize=14;spacing=12;" vertex="1" parent="1"><mxGeometry x="410" y="720" width="780" height="110" as="geometry"/></mxCell>
