<mxfile host="app.diagrams.net"><diagram name="Task 14 - WEARO MVP Architecture Map"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="WEARO — MVP ARCHITECTURE MAP" style="text;html=1;fontSize=26;fontStyle=1;align=center" vertex="1" parent="1"><mxGeometry x="500" y="20" width="650" height="55" as="geometry"/></mxCell><mxCell id="customer" value="CUSTOMER EXPERIENCE&#xa;Discover → Product → Account → Wishlist → AI → Cart → Checkout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="40" y="140" width="360" height="130" as="geometry"/></mxCell><mxCell id="ai" value="AI EXPERIENCE&#xa;AI Stylist → Outfit Recommendation → Virtual Try-On&#xa;Server-side AI credentials" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="470" y="140" width="360" height="130" as="geometry"/></mxCell><mxCell id="commerce" value="COMMERCE CORE&#xa;Products → Cart → Order → Payment → Invoice&#xa;COD / VietQR / MoMo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="900" y="140" width="360" height="130" as="geometry"/></mxCell><mxCell id="platform" value="PLATFORM / BACKEND&#xa;WEARO Frontend + Server/API&#xa;Validation / business logic / orchestration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="470" y="360" width="360" height="130" as="geometry"/></mxCell><mxCell id="supabase" value="SUPABASE — SOURCE OF TRUTH&#xa;Auth / Database / Storage&#xa;Products / Accounts / Wishlist / Orders / Payments / AI metadata&#xa;RLS + constraints" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="900" y="360" width="360" height="150" as="geometry"/></mxCell><mxCell id="admin" value="ADMIN / OPERATIONS&#xa;Auth + Role → Dashboard&#xa;Product / Order / Payment / User operations&#xa;Safe transaction handling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="40" y="360" width="360" height="150" as="geometry"/></mxCell><mxCell id="deploy" value="DEPLOYMENT&#xa;GitHub → Vercel Build → Preview / Production&#xa;Environment Variables / Runtime Logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="40" y="600" width="360" height="130" as="geometry"/></mxCell><mxCell id="security" value="SECURITY + QA&#xa;Auth / RLS / Ownership / Secrets&#xa;Loading / Empty / Error / Success / Retry&#xa;Local → Preview → Production verification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;dashed=1;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="470" y="600" width="360" height="130" as="geometry"/></mxCell><mxCell id="external" value="EXTERNAL SERVICES&#xa;AI Provider / Payment Provider&#xa;Server-side integration only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="900" y="600" width="360" height="130" as="geometry"/></mxCell><mxCell id="e1" value="AI request" style="edgeStyle=orthogonalEdgeStyle;endArrow=block" edge="1" parent="1" source="customer" target="ai"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="Shopping" style="edgeStyle=orthogonalEdgeStyle;endArrow=block" edge="1" parent="1" source="customer" target="commerce"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="Requests" style="edgeStyle=orthogonalEdgeStyle;endArrow=block" edge="1" parent="1" source="customer" target="platform"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="Orchestration" style="edgeStyle=orthogonalEdgeStyle;endArrow=block" edge="1" parent="1" source="ai" target="platform"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="Commerce API" style="edgeStyle=orthogonalEdgeStyle;endArrow=block" edge