<mxfile host="app.diagrams.net"><diagram name="Task 11 - QA Error Flow"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="WEARO — QA / ERROR FLOW" style="text;html=1;fontSize=24;fontStyle=1" vertex="1" parent="1"><mxGeometry x="500" y="25" width="560" height="50" as="geometry"/></mxCell><mxCell id="ui" value="1. UI ACTION&#xa;Click / Submit / Upload&#xa;Search / CRUD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="50" y="190" width="210" height="110" as="geometry"/></mxCell><mxCell id="load" value="2. LOADING&#xa;Disable duplicate action&#xa;Show progress / skeleton" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc" vertex="1" parent="1"><mxGeometry x="330" y="190" width="230" height="110" as="geometry"/></mxCell><mxCell id="req" value="3. REQUEST&#xa;Payload / API call&#xa;Network status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc" vertex="1" parent="1"><mxGeometry x="630" y="190" width="220" height="110" as="geometry"/></mxCell><mxCell id="server" value="4. SERVER / FUNCTION&#xa;Validate input&#xa;Auth / business logic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc" vertex="1" parent="1"><mxGeometry x="920" y="190" width="250" height="110" as="geometry"/></mxCell><mxCell id="data" value="5. DATA / API&#xa;Supabase query&#xa;AI / Payment provider" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4" vertex="1" parent="1"><mxGeometry x="1240" y="190" width="240" height="110" as="geometry"/></mxCell><mxCell id="auth" value="6. AUTH / RLS / CONSTRAINT&#xa;Permission? Ownership?&#xa;Schema / FK / validation?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="760" y="430" width="300" height="130" as="geometry"/></mxCell><mxCell id="success" value="SUCCESS&#xa;Response OK&#xa;Update / refetch UI&#xa;Toast / confirmation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="1180" y="430" width="260" height="130" as="geometry"/></mxCell><mxCell id="error" value="ERROR&#xa;Normalize error&#xa;Keep useful context&#xa;No silent failure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="250" y="650" width="260" height="130" as="geometry"/></mxCell><mxCell id="empty" value="EMPTY / NOT READY&#xa;No data / pending payment&#xa;Explain next action" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="600" y="650" width="270" height="130" as="geometry"/></mxCell><mxCell id="retry" value="RETRY / RECOVERY&#xa;Retry safe request&#xa;Backoff where needed&#xa;User can continue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="960" y="650" width="270" height="130" as="geometry"/></mxCell><mxCell id="observe" value="QA CHECKPOINTS&#xa;Console / Network&#xa;Server logs / Vercel logs&#xa;Supabase logs / payment events&#xa;Test Local → Preview → Production" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeWidth=2;dashed=1" vertex="1" parent="1"><mxGeometry x="1180" y="650" width="300" height="150" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block" edge="1" parent="1" source="ui" target="load"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block" edge="1" parent="1" source="load" target="req"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;endArrow=block" edge="1" parent="1" source="req" target="server"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;endArrow=block" edge="1" parent="1" source="server" target="data"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="Check" style="edgeStyle=orthogonalEdgeStyle;endArrow=block" edge="1" parent="1" source="data" target="auth"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="PASS" style="edgeStyle=orthogonalEdgeStyle;endArrow=block" edge="1" parent="1" source="auth" target="success"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="FAIL" style="edgeStyle=orthogonalEdgeStyle;endArrow=block" edge="1" parent="1" source="auth" target="error"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="No result / pending" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;dashed=1" edge="1" parent="1" source="data" target="empty"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="Recover" style="edgeStyle=orthogonalEdgeStyle;endArrow=block" edge="1" parent="1" source="error" target="retry"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="Retry" style="edgeStyle=orthogonalEdgeStyle;endArrow=block" edge="1" parent="1" source="retry" target="req"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="Observe" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;dashed=1" edge="1" parent="1" source="error" target="observe"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="Observe" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;dashed=1" edge="1" parent="1" source="success" target="observe"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="DEBUG ORDER: UI → Request → Server Function/API → Supabase/External API → Auth/RLS → Database Constraint → Response → UI Refresh.&#xa;Every important flow should have Loading, Empty/Not Ready, Error, Success and Recovery states where applicable." style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fontSize=14" vertex="1" parent="1"><mxGeometry x="300" y="850" width="900" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>