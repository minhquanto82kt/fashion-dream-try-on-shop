<mxfile host="app.diagrams.net"><diagram name="Task 10 - Security RLS"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="WEARO — SECURITY + SUPABASE RLS" style="text;html=1;fontSize=24;fontStyle=1" vertex="1" parent="1"><mxGeometry x="480" y="30" width="620" height="50" as="geometry"/></mxCell><mxCell id="guest" value="GUEST&#xa;Public catalog&#xa;No private data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5" vertex="1" parent="1"><mxGeometry x="60" y="190" width="230" height="120" as="geometry"/></mxCell><mxCell id="customer" value="CUSTOMER&#xa;Authenticated session&#xa;Own account / orders / wishlist" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4" vertex="1" parent="1"><mxGeometry x="350" y="190" width="270" height="120" as="geometry"/></mxCell><mxCell id="admin" value="ADMIN&#xa;Authenticated + admin role&#xa;Administrative operations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc" vertex="1" parent="1"><mxGeometry x="680" y="190" width="270" height="120" as="geometry"/></mxCell><mxCell id="server" value="SERVER / API&#xa;Validate auth + input&#xa;Secrets stay server-side" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc" vertex="1" parent="1"><mxGeometry x="1010" y="190" width="270" height="120" as="geometry"/></mxCell><mxCell id="rls" value="SUPABASE RLS&#xa;Row-level authorization&#xa;User ownership / admin policy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="520" y="450" width="320" height="140" as="geometry"/></mxCell><mxCell id="db" value="DATABASE / STORAGE&#xa;Source of truth&#xa;Constraints + private objects" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7" vertex="1" parent="1"><mxGeometry x="520" y="680" width="320" height="120" as="geometry"/></mxCell><mxCell id="e1" value="Public read" style="edgeStyle=orthogonalEdgeStyle;endArrow=block" edge="1" parent="1" source="guest" target="rls"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="Own rows" style="edgeStyle=orthogonalEdgeStyle;endArrow=block" edge="1" parent="1" source="customer" target="rls"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="Admin policy" style="edgeStyle=orthogonalEdgeStyle;endArrow=block" edge="1" parent="1" source="admin" target="rls"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="Server operations" style="edgeStyle=orthogonalEdgeStyle;endArrow=block" edge="1" parent="1" source="server" target="rls"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="Allow / deny" style="edgeStyle=orthogonalEdgeStyle;endArrow=block" edge="1" parent="1" source="rls" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="Security rule: Client never receives service-role secrets. Authorization is enforced server-side and at the database policy layer; UI hiding is not a security boundary." style="rounded=1;whiteSpace=wrap;html=1;dashed=1" vertex="1" parent="1"><mxGeometry x="350" y="860" width="660" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>