<mxfile host="app.diagrams.net"><diagram name="WEARO Supabase ERD"><mxGraphModel grid="1" page="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="auth" value="auth.users&#xa;id (UUID)&#xa;Supabase Auth" style="shape=table;startSize=30;container=1;collapsible=0;childLayout=tableLayout;rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="210" height="100" as="geometry"/></mxCell><mxCell id="admin" value="admin_users&#xa;PK user_id UUID&#xa;created_at" style="shape=table;startSize=30;container=1;collapsible=0;childLayout=tableLayout;rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="210" height="100" as="geometry"/></mxCell><mxCell id="products" value="products&#xa;PK id TEXT&#xa;slug UNIQUE&#xa;name, price, category&#xa;active, status, featured" style="shape=table;startSize=30;container=1;collapsible=0;childLayout=tableLayout;rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="40" width="240" height="140" as="geometry"/></mxCell><mxCell id="variants" value="product_variants&#xa;PK id UUID&#xa;FK product_id → products.id&#xa;size, color, sku, stock&#xa;UNIQUE product + size + color" style="shape=table;startSize=30;container=1;collapsible=0;childLayout=tableLayout;rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="680" y="40" width="250" height="140" as="geometry"/></mxCell><mxCell id="images" value="product_images&#xa;PK id UUID&#xa;FK product_id → products.id&#xa;image_url, alt_text, sort_order&#xa;is_primary" style="shape=table;startSize=30;container=1;collapsible=0;childLayout=tableLayout;rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="680" y="220" width="250" height="140" as="geometr