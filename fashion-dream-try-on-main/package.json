    "lucide-react": "^0.468.0",
    "react-day-picker": "^9.8.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.71.1",
    "react-resizable-panels": "^4.7.1",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
