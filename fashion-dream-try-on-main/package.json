{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "packageManager": "npm@11",
  "engines": {"node": ">=24 <25"},
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "deploy:cloudflare": "npm run build && npx wrangler deploy",
    "cf-typegen": "npx wrangler types",
    "lint": "eslint . --rule 'prettier/prettier: off' --rule 'no-empty: off' --rule 'no-useless-escape: off' --rule 'no-extra-boolean-cast: off'",
    "typecheck": "vite build && tsc --noEmit",
    "format": "prettier --write .",
    "test:smoke": "node tests/smoke/routes.mjs",
    "test:phase-b-c": "node tests/smoke/phase-b-c-invariants.mjs",
    "test:phase-d-e": "node tests/smoke/phase-d-e-invariants.mjs",
    "test:phase-f-security": "node tests/security/phase-f-security.mjs",
    "test:customer-experience": "npm run test:smoke && npm run test:phase-b-c && npm run test:phase-d-e && npm run test:phase-f-security",
    "audit:dependencies": "npm audit --audit-level=high",
    "security:secrets": "git grep -n -I -E '(SUPABASE_SECRET_KEY|MOMO_SECRET_KEY|VERCEL_ACCESS_TOKEN|OPENAI_API_KEY|REPLICATE_API_TOKEN|PRIVATE_KEY)\\s*[:=]' -- ':!*.md' ':!*.example' || true"
  },
  "overrides": {"rolldown": "1.2.1"},
  "dependencies": {
