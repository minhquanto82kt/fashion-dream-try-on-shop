{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --production=false --package-lock=false",
  "functions": {
    "api/[...path].py": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/try-on/internal/worker/reconcile",
      "schedule": "* * * * *"
    }
  ]
}
